class Solution {
    int[] nums;
    int n, size;
    int[] cost;
    int[] dp;

    public int minimumIncompatibility(int[] nums, int k) {
        this.nums = nums;
        n = nums.length;
        size = n / k;

        int totalMask = 1 << n;
        cost = new int[totalMask];
        java.util.Arrays.fill(cost, -1);

        // Precompute valid subsets
        for (int mask = 0; mask < totalMask; mask++) {
            if (Integer.bitCount(mask) != size) continue;

            java.util.HashSet<Integer> set = new java.util.HashSet<>();
            int min = Integer.MAX_VALUE;
            int max = Integer.MIN_VALUE;
            boolean valid = true;

            for (int i = 0; i < n; i++) {
                if ((mask & (1 << i)) != 0) {
                    if (!set.add(nums[i])) {
                        valid = false;
                        break;
                    }
                    min = Math.min(min, nums[i]);
                    max = Math.max(max, nums[i]);
                }
            }

            if (valid)
                cost[mask] = max - min;
        }

        dp = new int[totalMask];
        java.util.Arrays.fill(dp, Integer.MAX_VALUE);
        dp[0] = 0;

        for (int mask = 0; mask < totalMask; mask++) {
            if (dp[mask] == Integer.MAX_VALUE) continue;

            int remain = (~mask) & (totalMask - 1);
            if (remain == 0) continue;

            int first = Integer.numberOfTrailingZeros(remain);

            for (int sub = remain; sub > 0; sub = (sub - 1) & remain) {
                if ((sub & (1 << first)) == 0) continue;
                if (cost[sub] == -1) continue;

                dp[mask | sub] = Math.min(dp[mask | sub], dp[mask] + cost[sub]);
            }
        }

        return dp[totalMask - 1] == Integer.MAX_VALUE ? -1 : dp[totalMask - 1];
    }
}
